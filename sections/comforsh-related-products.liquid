{% liquid
  assign heading = section.settings.heading | default: 'Das könnte Ihnen auch gefallen'
  assign limit = section.settings.products_to_show | default: 8
  assign source_products = collections.all.products

  if product != blank and product.collections.size > 0
    assign source_products = product.collections.first.products
  endif

  assign shown = 0
%}

<section
  class="cfp-related"
  id="ComforshRelated-{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width cfp-related__inner">
    {% if heading != blank %}
      <header class="cfp-related__header">
        <div>
          <h2 class="cfp-related__heading">{{ heading | escape }}</h2>
          {% if section.settings.subtitle != blank %}
            <p class="cfp-related__sub">{{ section.settings.subtitle | escape }}</p>
          {% endif %}
        </div>
        <div class="cfp-related__nav">
          <button type="button" class="cfp-related__arrow" data-related-prev aria-label="Zurück">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" class="cfp-related__arrow" data-related-next aria-label="Weiter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </header>
    {% endif %}

    <div class="cfp-related__viewport">
      <div class="cfp-related__track" data-related-track>
        {% for related in source_products %}
          {% liquid
            assign skip = false
            if product != blank and related.id == product.id
              assign skip = true
            endif
          %}
          {% if skip == false and shown < limit %}
            {% assign shown = shown | plus: 1 %}
            {% assign variant = related.selected_or_first_available_variant %}
            <article class="cfp-related__card">
              <a class="cfp-related__media" href="{{ related.url }}">
                {% if related.featured_media != blank %}
                  {{
                    related.featured_media
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 400, 600, 800',
                      sizes: '(min-width: 990px) 22vw, 45vw',
                      alt: related.title,
                      class: 'cfp-related__img'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'cfp-related__img' }}
                {% endif %}
              </a>
              <div class="cfp-related__body">
                <h3 class="cfp-related__title">
                  <a href="{{ related.url }}">{{ related.title | escape }}</a>
                </h3>
                <p class="cfp-related__price">{{ variant.price | money }}</p>
                {% if variant.available %}
                  <button
                    type="button"
                    class="cfp-related__btn"
                    data-related-atc
                    data-variant-id="{{ variant.id }}"
                    data-product-title="{{ related.title | escape }}"
                  >
                    {{ section.settings.button_label | default: 'In den Warenkorb' | escape }}
                  </button>
                {% else %}
                  <a class="cfp-related__btn" href="{{ related.url }}">Ansehen</a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('ComforshRelated-{{ section.id }}');
    if (!root) return;
    const track = root.querySelector('[data-related-track]');
    const prev = root.querySelector('[data-related-prev]');
    const next = root.querySelector('[data-related-next]');
    if (!track || !prev || !next) return;

    const updateArrows = () => {
      const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth - 2);
      const atStart = track.scrollLeft <= 2;
      const atEnd = track.scrollLeft >= maxScroll;
      prev.disabled = atStart;
      next.disabled = atEnd || maxScroll <= 0;
      prev.setAttribute('aria-disabled', atStart ? 'true' : 'false');
      next.setAttribute('aria-disabled', next.disabled ? 'true' : 'false');
    };

    const scrollByCard = (dir) => {
      const card = track.querySelector('.cfp-related__card');
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap) || 20;
      const amount = card ? card.getBoundingClientRect().width + gap : 280;
      track.scrollBy({ left: dir * amount, behavior: 'smooth' });
      setTimeout(updateArrows, 320);
    };

    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();

    root.querySelectorAll('[data-related-atc]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!window.ComforshCart) return;
        const id = btn.getAttribute('data-variant-id');
        const title = btn.getAttribute('data-product-title') || '';
        const original = btn.textContent;
        btn.disabled = true;
        btn.textContent = '…';
        try {
          await window.ComforshCart.add({ id, quantity: 1, title });
          btn.textContent = 'Hinzugefügt ✓';
          setTimeout(() => {
            btn.textContent = original;
            btn.disabled = false;
          }, 1400);
        } catch (e) {
          btn.textContent = original;
          btn.disabled = false;
        }
      });
    });
  })();
</script>

{% stylesheet %}
  .cfp-related {
    background: #ffffff;
    border-top: 1px solid #ececec;
  }

  .cfp-related__inner {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .cfp-related__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .cfp-related__heading {
    margin: 0 0 0.35rem;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 800;
    color: #111111;
    letter-spacing: -0.02em;
  }

  .cfp-related__sub {
    margin: 0;
    color: #6b7280;
    font-size: 0.95rem;
  }

  .cfp-related__nav {
    display: flex;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .cfp-related__arrow {
    width: 40px;
    height: 40px;
    border: 1.5px solid #111111;
    border-radius: 50%;
    background: #fff;
    color: #111111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .cfp-related__arrow:hover:not(:disabled) {
    background: #6b2317;
    color: #fff;
  }

  .cfp-related__arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .cfp-related__viewport {
    overflow: hidden;
  }

  .cfp-related__track {
    display: flex;
    gap: 1.15rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 0.35rem;
    scrollbar-width: none;
  }

  .cfp-related__track::-webkit-scrollbar {
    display: none;
  }

  .cfp-related__card {
    flex: 0 0 calc(50% - 0.575rem);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .cfp-related__card {
      flex-basis: calc(33.333% - 0.8rem);
    }
  }

  @media screen and (min-width: 990px) {
    .cfp-related__card {
      flex-basis: calc(25% - 0.9rem);
    }
  }

  .cfp-related__media {
    display: block;
    aspect-ratio: 1 / 1;
    border: 0;
    border-radius: 4px;
    overflow: hidden;
    background: #f3f3f3;
  }

  .cfp-related__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .cfp-related__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .cfp-related__title {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.35;
    color: #111111;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-height: calc(1.35em * 2);
  }

  .cfp-related__title a {
    color: inherit;
    text-decoration: none;
  }

  .cfp-related__title a:hover {
    opacity: 0.7;
  }

  .cfp-related__price {
    margin: 0.35rem 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #111111;
  }

  .cfp-related__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    height: 44px;
    margin-top: auto;
    border: 1.5px solid #111111;
    border-radius: 4px;
    background: #822c1d;
    color: #fff !important;
    text-decoration: none !important;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }

  .cfp-related__btn:hover:not(:disabled) {
    background: #6b2317;
  }

  .cfp-related__btn:disabled {
    opacity: 0.7;
    cursor: wait;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "class": "section-comforsh-related",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Weitere beliebte Produkte aus unserem Sortiment"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Card button label",
      "default": "Add to cart"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
