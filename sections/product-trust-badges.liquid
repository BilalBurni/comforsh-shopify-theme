{% comment %}
  Small trust row for product pages — editable, no emoji.
{% endcomment %}

<section
  class="pdp-trust"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width pdp-trust__inner">
    <div class="pdp-trust__grid">
      {% for block in section.blocks %}
        <div class="pdp-trust__item" {{ block.shopify_attributes }}>
          <span class="pdp-trust__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'shipping' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {% when 'returns' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
              {% when 'secure' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              {% else %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            {% endcase %}
          </span>
          <span class="pdp-trust__label">{{ block.settings.label | escape }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-trust {
    background: #faf9f6;
  }

  .pdp-trust__inner {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .pdp-trust__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    border-radius: 4px;
    padding: 1rem 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .pdp-trust__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .pdp-trust__item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: #1f2937;
  }

  .pdp-trust__icon {
    color: #822c1d;
    display: inline-flex;
  }

  .pdp-trust__label {
    font-size: 0.9rem;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Trust Badges",
  "tag": "section",
  "class": "section-product-trust",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "secure", "label": "Secure" },
            { "value": "returns", "label": "Returns" },
            { "value": "guarantee", "label": "Guarantee" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "secure", "label": "Secure payment" } },
        { "type": "badge", "settings": { "icon": "shipping", "label": "Free shipping" } },
        { "type": "badge", "settings": { "icon": "returns", "label": "Easy returns" } }
      ]
    }
  ]
}
{% endschema %}
