{% liquid
  assign eyebrow = 'comforsh.hero.eyebrow' | t
  assign heading = 'comforsh.hero.heading' | t
  assign text = 'comforsh.hero.text' | t
  assign urgency = 'comforsh.hero.urgency' | t
  assign button_label = 'comforsh.hero.button' | t

  comment
    Values coming from `t` are already HTML-escaped by Shopify, so the settings
    fallbacks are escaped here instead and nothing is escaped again on output.
  endcomment
  if eyebrow == 'comforsh.hero.eyebrow' or eyebrow contains 'Translation missing'
    assign eyebrow = section.settings.eyebrow | escape
  endif
  if heading == 'comforsh.hero.heading' or heading contains 'Translation missing'
    assign heading = section.settings.heading | escape
  endif
  if text == 'comforsh.hero.text' or text contains 'Translation missing'
    assign text = section.settings.text | escape
  endif
  if urgency == 'comforsh.hero.urgency' or urgency contains 'Translation missing'
    assign urgency = section.settings.urgency | escape
  endif
  if button_label == 'comforsh.hero.button' or button_label contains 'Translation missing'
    assign button_label = section.settings.button_label | escape
  endif

  assign button_link = section.settings.button_link
  assign poster = section.settings.poster_image
  assign shopify_video = section.settings.video
  assign video_url = section.settings.video_url
  assign video_url_2 = section.settings.video_url_2
  assign video_url_3 = section.settings.video_url_3
  assign height = section.settings.height
  assign scene_seconds = section.settings.scene_seconds | default: 7
  assign playlist_count = 0
  if video_url != blank
    assign playlist_count = playlist_count | plus: 1
  endif
  if video_url_2 != blank
    assign playlist_count = playlist_count | plus: 1
  endif
  if video_url_3 != blank
    assign playlist_count = playlist_count | plus: 1
  endif
%}

<section
  class="cv-hero cv-hero--{{ height }}"
  id="ComforshVideoHero-{{ section.id }}"
  {% if shopify_video == blank and playlist_count > 1 %}
    data-cv-playlist
    data-scene-seconds="{{ scene_seconds }}"
  {% endif %}
>
  <div class="cv-hero__media" aria-hidden="true">
    {% if shopify_video != blank %}
      {{
        shopify_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          class: 'cv-hero__video',
          image_size: '1920x'
      }}
    {% elsif video_url != blank %}
      <div class="cv-hero__playlist">
        <video
          class="cv-hero__video is-active"
          autoplay
          muted
          {% if playlist_count < 2 %}loop{% endif %}
          playsinline
          preload="{% if poster != blank %}none{% else %}metadata{% endif %}"
          {% if poster != blank %}poster="{{ poster | image_url: width: 1600 }}"{% endif %}
          data-src="{{ video_url | escape }}"
        >
          <source src="{{ video_url }}" type="video/mp4">
        </video>
        {% if video_url_2 != blank %}
          <video
            class="cv-hero__video"
            muted
            playsinline
            preload="metadata"
            data-src="{{ video_url_2 | escape }}"
          >
            <source src="{{ video_url_2 }}" type="video/mp4">
          </video>
        {% endif %}
        {% if video_url_3 != blank %}
          <video
            class="cv-hero__video"
            muted
            playsinline
            preload="none"
            data-src="{{ video_url_3 | escape }}"
          >
            <source src="{{ video_url_3 }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
    {% elsif poster != blank %}
      {{
        poster
        | image_url: width: 2400
        | image_tag:
          class: 'cv-hero__video cv-hero__video--image',
          widths: '800, 1200, 1600, 1920, 2400',
          sizes: '100vw',
          fetchpriority: 'high',
          alt: heading
      }}
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'cv-hero__video cv-hero__video--image' }}
    {% endif %}
    <div class="cv-hero__overlay"></div>
  </div>

  <div class="cv-hero__content page-width">
    <div class="cv-hero__copy">
      {% if eyebrow != blank %}
        <p class="cv-hero__eyebrow">{{ eyebrow }}</p>
      {% endif %}
      {% if heading != blank %}
        <h1 class="cv-hero__heading">{{ heading }}</h1>
      {% endif %}
      {% if text != blank %}
        <p class="cv-hero__text">{{ text }}</p>
      {% endif %}
      {% if urgency != blank %}
        <p class="cv-hero__urgency">{{ urgency }}</p>
      {% endif %}
      {% if button_label != blank %}
        <a
          class="cv-hero__btn"
          href="{{ button_link | default: collections.all.url }}"
        >
          {{ button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cv-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #1f2937;
    color: #ffffff;
    display: flex;
    align-items: center;
  }

  .cv-hero--medium {
    min-height: clamp(420px, 62vh, 680px);
  }

  .cv-hero--large {
    min-height: clamp(520px, 78vh, 820px);
  }

  /*
    The header is opaque and sits above the hero, so a plain 100vh would push
    the bottom of the hero below the fold. Subtracting the header height makes
    header + hero add up to exactly one screen.

    svh (small viewport height) is used where supported so mobile browsers do
    not crop the hero when the URL bar is showing; the vh line above it is the
    fallback for older browsers.
  */
  .cv-hero--full {
    min-height: calc(100vh - var(--header-group-height, 0px));
    min-height: calc(100svh - var(--header-group-height, 0px));
  }

  .cv-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cv-hero__playlist {
    position: absolute;
    inset: 0;
  }

  .cv-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cv-hero__playlist .cv-hero__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
    transform: scale(1.04);
  }

  .cv-hero__playlist .cv-hero__video.is-active {
    opacity: 1;
    z-index: 1;
  }

  /*
    A still poster reads as a dead page, so the image gets a slow ken-burns
    drift. Pure CSS on purpose: the hero is above the fold, and waiting for the
    deferred motion script would show a visible flash before anything moved.
  */
  .cv-hero__video--image {
    transform-origin: 55% 45%;
    animation: cv-hero-ken 26s ease-in-out infinite alternate;
  }

  @keyframes cv-hero-ken {
    from { transform: scale(1.02) translate3d(0, 0, 0); }
    to { transform: scale(1.12) translate3d(0, -1.2%, 0); }
  }

  /* Copy rises in on load, one line after the next. */
  .cv-hero__copy > * {
    opacity: 0;
    animation: cv-hero-in 0.85s cubic-bezier(0.26, 0.54, 0.32, 1) forwards;
  }

  .cv-hero__copy > *:nth-child(1) { animation-delay: 0.15s; }
  .cv-hero__copy > *:nth-child(2) { animation-delay: 0.28s; }
  .cv-hero__copy > *:nth-child(3) { animation-delay: 0.41s; }
  .cv-hero__copy > *:nth-child(4) { animation-delay: 0.54s; }
  .cv-hero__copy > *:nth-child(5) { animation-delay: 0.67s; }

  @keyframes cv-hero-in {
    from { opacity: 0; transform: translate3d(0, 26px, 0); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-hero__video:not(.cv-hero__video--image),
    .cv-hero__video--image {
      animation: none;
      transform: none;
    }

    .cv-hero__playlist .cv-hero__video {
      transition: none;
      transform: none;
    }

    /* Land on the finished state rather than animating to it. */
    .cv-hero__copy > * {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }

  .cv-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(17, 24, 39, 0.72) 0%,
      rgba(17, 24, 39, 0.4) 36%,
      rgba(17, 24, 39, 0.1) 60%,
      transparent 75%
    );
  }

  .cv-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding: clamp(3rem, 8vh, 6rem) clamp(1.25rem, 5vw, 4rem);
  }

  .cv-hero__copy {
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .cv-hero__eyebrow {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    opacity: 0.95;
  }

  .cv-hero__heading {
    margin: 0;
    font-size: clamp(2.1rem, 5.5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #ffffff;
    max-width: 14ch;
  }

  .cv-hero__text {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.55;
    color: #f3f4f6;
    max-width: 36ch;
  }

  .cv-hero__urgency {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: #e5e7eb;
    max-width: 36ch;
  }

  .cv-hero__btn {
    margin-top: 0.55rem;
    min-width: 168px;
  }

  @media screen and (max-width: 749px) {
    .cv-hero__overlay {
      background: linear-gradient(
        to top,
        rgba(17, 24, 39, 0.85) 0%,
        rgba(17, 24, 39, 0.5) 50%,
        rgba(17, 24, 39, 0.2) 78%,
        transparent 100%
      );
    }

    .cv-hero__content {
      align-items: flex-end;
      min-height: inherit;
      display: flex;
      padding-bottom: 2.5rem;
    }

    .cv-hero__heading {
      max-width: none;
    }

    .cv-hero__btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% if shopify_video == blank and playlist_count > 1 %}
  <script>
    (function () {
      var root = document.getElementById('ComforshVideoHero-{{ section.id }}');
      if (!root || !root.hasAttribute('data-cv-playlist')) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var videos = Array.prototype.slice.call(root.querySelectorAll('.cv-hero__playlist .cv-hero__video'));
      if (videos.length < 2) return;

      var sceneMs = Math.max(4, Number(root.getAttribute('data-scene-seconds')) || 7) * 1000;
      var index = 0;
      var timer = null;

      function playAt(i) {
        videos.forEach(function (video, n) {
          if (n === i) {
            video.classList.add('is-active');
            try {
              video.currentTime = 0;
              var playPromise = video.play();
              if (playPromise && playPromise.catch) playPromise.catch(function () {});
            } catch (e) {}
          } else {
            video.classList.remove('is-active');
            try { video.pause(); } catch (e) {}
          }
        });
      }

      function next() {
        index = (index + 1) % videos.length;
        playAt(index);
      }

      playAt(0);
      timer = setInterval(next, sceneMs);

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
          if (timer) clearInterval(timer);
          timer = null;
          videos.forEach(function (v) { try { v.pause(); } catch (e) {} });
        } else {
          playAt(index);
          if (!timer) timer = setInterval(next, sceneMs);
        }
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Video Hero Banner",
  "tag": "section",
  "class": "section-comforsh-video-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video",
      "info": "Upload a short looping lifestyle video in Shopify Files / Theme Editor for best quality."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Clip 1 — posture / stretch",
      "info": "Used when no Shopify video is selected. Category mood: back, neck, desk comfort."
    },
    {
      "type": "text",
      "id": "video_url_2",
      "label": "Clip 2 — sleep / morning",
      "info": "Optional. Soft-crossfades with clip 1. Category mood: sleep & recovery."
    },
    {
      "type": "text",
      "id": "video_url_3",
      "label": "Clip 3 — relief / massage",
      "info": "Optional. Category mood: pain relief & massage."
    },
    {
      "type": "range",
      "id": "scene_seconds",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds per clip",
      "default": 7
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster / fallback image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ERGONOMISCHER KOMFORT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SIT. BREATHE. FEEL WELL."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Premium comfort products for posture, relaxation and everyday wellbeing."
    },
    {
      "type": "textarea",
      "id": "urgency",
      "label": "Urgency line",
      "default": "Free shipping ab €50 · 30-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Video Hero Banner"
    }
  ]
}
{% endschema %}
