{%- comment -%}
  Dual lifestyle images — Leszly-style lookbook strip.
{%- endcomment -%}

<section
  class="cfp-look"
  style="
    --cfp-look-pad-top: {{ section.settings.padding_top }}px;
    --cfp-look-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cfp-look-gap: {{ section.settings.gap }}px;
  "
>
  <div class="page-width cfp-look__inner">
    <div class="cfp-look__grid">
      {% for block in section.blocks %}
        {% liquid
          assign image = block.settings.image
          assign link = block.settings.link
          assign alt = block.settings.alt
          assign fallback_url = block.settings.fallback_image_url
          if alt == blank
            assign alt = 'Lifestyle'
          endif
        %}
        <div class="cfp-look__item" data-cf-reveal="zoom" {{ block.shopify_attributes }}>
          {% if link != blank %}
            <a class="cfp-look__link" href="{{ link }}">
          {% else %}
            <div class="cfp-look__link">
          {% endif %}

          {% if image != blank %}
            {{
              image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 960, 1200, 1600',
                sizes: '(min-width: 750px) 48vw, 100vw',
                class: 'cfp-look__img cf-parallax',
                alt: alt
            }}
          {% elsif fallback_url != blank %}
            <img
              class="cfp-look__img cf-parallax"
              src="{{ fallback_url | escape }}"
              alt="{{ alt | escape }}"
              loading="lazy"
              width="1200"
              height="1500"
            >
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'cfp-look__img cfp-look__img--placeholder' }}
          {% endif %}

          {% if link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cfp-look {
    background: #ffffff;
    padding: var(--cfp-look-pad-top, 24px) 0 var(--cfp-look-pad-bottom, 24px);
  }

  .cfp-look__inner {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .cfp-look__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--cfp-look-gap, 12px);
  }

  @media screen and (min-width: 750px) {
    .cfp-look__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cfp-look__item {
    min-width: 0;
  }

  .cfp-look__link {
    display: block;
    overflow: hidden;
    border-radius: 8px;
    background: #f3f4f6;
    aspect-ratio: 4 / 5;
    text-decoration: none;
  }

  .cfp-look__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .cfp-look__img--placeholder {
    opacity: 0.4;
    object-fit: contain;
    padding: 15%;
  }

  .cfp-look__link:hover .cfp-look__img {
    transform: scale(1.03);
  }

  /*
    With parallax active the image already carries a translate, so the hover
    zoom has to go through the scale variable instead of replacing the
    transform (which would snap the image back to its unscrolled position).
  */
  .cf-ready .cfp-look__link:hover .cfp-look__img.cf-parallax {
    transform: translate3d(0, var(--cf-shift, 0px), 0) scale(var(--cf-parallax-scale, 1.12));
    --cf-parallax-scale: 1.18;
    transition: transform 0.45s var(--cf-ease);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook images",
  "tag": "section",
  "class": "section-comforsh-lookbook",
  "max_blocks": 2,
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Gap between images",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Lifestyle"
        },
        {
          "type": "text",
          "id": "fallback_image_url",
          "label": "Fallback image URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook images",
      "blocks": [
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
