{%- comment -%}
  Premium All Collections hub — Leszly-style grid of every collection.
{%- endcomment -%}

{% liquid
  assign title = section.settings.title | default: 'All Collections'
  assign subtitle = section.settings.subtitle
%}

<section
  class="cfcgrid"
  style="
    --cfcgrid-pad-top: {{ section.settings.padding_top }}px;
    --cfcgrid-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width cfcgrid__inner">
    <nav class="cfcgrid__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ section.settings.home_label | default: 'Startseite' | escape }}</a>
      <span aria-hidden="true">/</span>
      <span>{{ title | escape }}</span>
    </nav>

    <header class="cfcgrid__header">
      <h1 class="cfcgrid__title">{{ title | escape }}</h1>
      {% if subtitle != blank %}
        <p class="cfcgrid__sub">{{ subtitle | escape }}</p>
      {% endif %}
    </header>

    <div class="cfcgrid__grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign col = block.settings.collection
            assign card_title = block.settings.title
            assign card_text = block.settings.text
            if col != blank
              if card_title == blank
                assign card_title = col.title
              endif
              assign card_url = col.url
              assign card_image = block.settings.image | default: col.featured_image
              assign card_count = col.products_count
            else
              assign card_url = routes.all_products_collection_url
              assign card_image = block.settings.image
              assign card_count = blank
            endif
          %}
          {% if card_title != blank %}
            <a class="cfcgrid__card" href="{{ card_url }}" {{ block.shopify_attributes }}>
              <div class="cfcgrid__media">
                {% if card_image != blank %}
                  {{
                    card_image
                    | image_url: width: 1000
                    | image_tag:
                      class: 'cfcgrid__img',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 30vw, 90vw',
                      alt: card_title
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'cfcgrid__img cfcgrid__img--ph' }}
                {% endif %}
              </div>
              <div class="cfcgrid__body">
                <h2 class="cfcgrid__name">{{ card_title | escape }}</h2>
                {% if card_text != blank %}
                  <p class="cfcgrid__text">{{ card_text | escape }}</p>
                {% endif %}
                <div class="cfcgrid__meta">
                  {% if card_count != blank %}
                    <span>{{ card_count }} {% if card_count == 1 %}product{% else %}products{% endif %}</span>
                  {% endif %}
                  <span class="cfcgrid__shop">
                    {{ section.settings.shop_label | default: 'Shop now' | escape }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for col in collections %}
          {% if col.handle != 'frontpage' %}
            <a class="cfcgrid__card" href="{{ col.url }}">
              <div class="cfcgrid__media">
                {% if col.featured_image != blank %}
                  {{
                    col.featured_image
                    | image_url: width: 1000
                    | image_tag:
                      class: 'cfcgrid__img',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 30vw, 90vw',
                      alt: col.title
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'cfcgrid__img cfcgrid__img--ph' }}
                {% endif %}
              </div>
              <div class="cfcgrid__body">
                <h2 class="cfcgrid__name">{{ col.title | escape }}</h2>
                <div class="cfcgrid__meta">
                  <span>{{ col.products_count }} {% if col.products_count == 1 %}product{% else %}products{% endif %}</span>
                  <span class="cfcgrid__shop">
                    {{ section.settings.shop_label | default: 'Shop now' | escape }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cfcgrid {
    background: #ffffff;
    padding: var(--cfcgrid-pad-top, 48px) 0 var(--cfcgrid-pad-bottom, 80px);
  }

  .cfcgrid__inner {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .cfcgrid__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    font-size: 0.78rem;
    color: #9ca3af;
  }

  .cfcgrid__crumbs a {
    color: #9ca3af;
    text-decoration: none;
  }

  .cfcgrid__crumbs a:hover {
    color: #111111;
  }

  .cfcgrid__header {
    margin-bottom: 2rem;
  }

  .cfcgrid__title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #111111;
  }

  .cfcgrid__sub {
    margin: 0;
    max-width: 42ch;
    font-size: 1rem;
    line-height: 1.6;
    color: #6b7280;
  }

  .cfcgrid__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .cfcgrid__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .cfcgrid__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }

  .cfcgrid__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 0;
    min-width: 0;
  }

  .cfcgrid__media {
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    overflow: hidden;
    background: #f3f3f3;
  }

  .cfcgrid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .cfcgrid__img--ph {
    object-fit: contain;
    padding: 2rem;
    opacity: 0.45;
  }

  .cfcgrid__card:hover .cfcgrid__img {
    transform: scale(1.04);
  }

  .cfcgrid__body {
    padding: 0.95rem 0.1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .cfcgrid__name {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #111111;
    line-height: 1.3;
  }

  .cfcgrid__text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #6b7280;
  }

  .cfcgrid__meta {
    margin-top: auto;
    padding-top: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #9ca3af;
  }

  .cfcgrid__shop {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #111111;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .cfcgrid__card:hover .cfcgrid__shop {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections grid",
  "tag": "section",
  "class": "section-cfcgrid",
  "settings": [
    {
      "type": "text",
      "id": "home_label",
      "label": "Breadcrumb home",
      "default": "Startseite"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "All Collections"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Shop ergonomic comfort by category — posture, sleep, seating and more."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop label",
      "default": "Shop now"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Short text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections grid"
    }
  ]
}
{% endschema %}
