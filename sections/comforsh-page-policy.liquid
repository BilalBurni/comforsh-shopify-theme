{%- comment -%}
  Simple content page for Shipping / Returns style footer pages.
  Body can come from page.content or section richtext.
{%- endcomment -%}

<section
  class="cfp-policy"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cfp-policy__hero">
    <div class="page-width cfp-policy__hero-inner">
      {% if section.settings.eyebrow != blank %}
        <p class="cfp-policy__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="cfp-policy__title">
        {{ section.settings.title | default: page.title | escape }}
      </h1>
      {% if section.settings.subtitle != blank %}
        <p class="cfp-policy__sub">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </div>
  </div>

  <div class="page-width cfp-policy__inner">
    <div class="cfp-policy__content rte">
      {% if section.settings.content != blank %}
        {{ section.settings.content }}
      {% elsif page.content != blank %}
        {{ page.content }}
      {% else %}
        <p>{{ section.settings.empty_text | escape }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cfp-policy {
    background: var(--color-comforsh-bg, #faf9f6);
    color: var(--color-comforsh-text, #1f2937);
  }

  .cfp-policy__hero {
    background: linear-gradient(180deg, #eef2f0 0%, #faf9f6 100%);
    border-bottom: 1px solid #e8e8e8;
    padding: 3.5rem 0 2.75rem;
    margin-bottom: 2.5rem;
  }

  .cfp-policy__hero-inner,
  .cfp-policy__inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .cfp-policy__eyebrow {
    margin: 0 0 0.55rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-comforsh-accent, #822c1d);
  }

  .cfp-policy__title {
    margin: 0 0 0.65rem;
    font-size: clamp(1.85rem, 3.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #111827;
  }

  .cfp-policy__sub {
    margin: 0;
    color: #6b7280;
    line-height: 1.55;
  }

  .cfp-policy__content {
    font-size: 1.02rem;
    line-height: 1.7;
    color: #374151;
  }

  .cfp-policy__content h2,
  .cfp-policy__content h3 {
    color: #111827;
    margin: 1.75rem 0 0.65rem;
  }

  /*
    Without an explicit size these inherit the theme's display heading scale,
    which is far too large here: "Verbraucherstreitbeilegung" then broke
    mid-word on a phone. German legal copy is full of compound nouns like
    that, so the headings stay small and the whole block hyphenates properly
    rather than splitting at an arbitrary letter.
  */
  .cfp-policy__content h2 {
    font-size: clamp(1.12rem, 0.98rem + 0.9vw, 1.42rem);
    line-height: 1.3;
    font-weight: 600;
  }

  .cfp-policy__content h3 {
    font-size: clamp(1.02rem, 0.95rem + 0.5vw, 1.18rem);
    line-height: 1.35;
    font-weight: 600;
  }

  .cfp-policy__content h2,
  .cfp-policy__content h3,
  .cfp-policy__content p,
  .cfp-policy__content li {
    -webkit-hyphens: auto;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .cfp-policy__content p {
    margin: 0 0 1rem;
  }

  .cfp-policy__content ul {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Content page",
  "tag": "section",
  "class": "section-comforsh-page-policy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Leave blank to use the Shopify page title"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "info": "Optional. If blank, the page body from Admin is used."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty fallback",
      "default": "Content coming soon."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Content page"
    }
  ]
}
{% endschema %}
